# Browser-facing URLs
VITE_BFF_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:5173

# Server-only production Web reverse-proxy target
BFF_URL=http://localhost:3000

# Internal service URLs
ENGINE_BASE_URL=http://localhost:8080
ENGINE_ADDR=:8080
AUTH_DOMAIN=localhost:5173
AUTH_PURPOSE=login
# Base64-encoded 32-byte root key for local/dev envelope encryption. Generate
# and export it as documented in README; never commit a real value.
AGENT_CREDENTIAL_KEK_BASE64=
# Generate a distinct stable HMAC key so replay remains valid across KEK rotation.
AGENT_CREDENTIAL_IDEMPOTENCY_HMAC_BASE64=
AGENT_CREDENTIAL_KEY_REF=local-dev-agent-credentials-v1
# Keep false in production. Set true only when testing a private-network Agent.
AGENT_HEALTH_ALLOW_PRIVATE_NETWORKS=false

# Local infrastructure
DATABASE_URL=postgres://agent:agent@localhost:5432/agent_platform?sslmode=disable
REDIS_URL=redis://localhost:6379/0
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
TASK_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:agent-task-events
TASK_EXECUTION_QUEUE_URL=http://localhost:4566/000000000000/agent-task-execution

# Ethereum testnet configuration (decision pending)
# Local development chain only; configure an approved chain per environment.
EVM_CHAIN_ID=31337
EVM_RPC_URL=
ESCROW_CONTRACT_ADDRESS=
# Server-side expected resolver address for canonical dispute-freeze reconciliation.
# It must match the resolver configured in TaskEscrow; it is never a signing key.
DISPUTE_RESOLVER_ADDRESS=
# Separate server-only signing keys. Never expose or commit real values.
SELECTION_PROOF_SIGNING_KEY_HEX=
DELIVERY_PROOF_SIGNING_KEY_HEX=
ESCROW_DEPLOYMENT_BLOCK=0
EVM_CONFIRMATIONS=12
EVM_MAX_REORG_DEPTH=64
FUNDS_ASSET=evm:31337/native
# Required only when resolving a change order as platform responsibility.
PLATFORM_INCIDENT_OWNER_ID=

# Mastra one-sentence image generation Agent (Zhipu GLM-Image)
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IMAGE_AGENT_PORT=8092
IMAGE_AGENT_DATA_DIR=.data/image-generator
IMAGE_AGENT_API_TOKEN=
IMAGE_AGENT_PUBLIC_BASE_URL=
IMAGE_AGENT_PLANNER_MODEL=glm-4.5-flash
IMAGE_AGENT_JOB_CONCURRENCY=1
IMAGE_AGENT_CALLBACK_KEY_BASE64=
IMAGE_AGENT_CALLBACK_KEY_VERSION=image-agent-callback-v1

# Platform protocol endpoints for the two image-to-code Agents
GLM_IMAGE_TO_CODE_AGENT_PORT=8093
GLM_IMAGE_TO_CODE_AGENT_DATA_DIR=.data/glm-image-to-code
GLM_IMAGE_TO_CODE_AGENT_API_TOKEN=
GLM_IMAGE_TO_CODE_AGENT_PUBLIC_BASE_URL=
GLM_IMAGE_TO_CODE_AGENT_CALLBACK_KEY_BASE64=
GLM_IMAGE_TO_CODE_AGENT_CALLBACK_KEY_VERSION=glm-image-to-code-callback-v1
QWEN_IMAGE_TO_CODE_AGENT_PORT=8094
QWEN_IMAGE_TO_CODE_AGENT_DATA_DIR=.data/qwen-image-to-code
QWEN_IMAGE_TO_CODE_AGENT_API_TOKEN=
QWEN_IMAGE_TO_CODE_AGENT_PUBLIC_BASE_URL=
QWEN_IMAGE_TO_CODE_AGENT_CALLBACK_KEY_BASE64=
QWEN_IMAGE_TO_CODE_AGENT_CALLBACK_KEY_VERSION=qwen-image-to-code-callback-v1
