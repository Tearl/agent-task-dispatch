# Browser-facing URLs
VITE_BFF_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:5173

# Server-only production Web reverse-proxy target
BFF_URL=http://localhost:3000

# Internal service URLs
ENGINE_BASE_URL=http://localhost:8080
# Bounds each BFF -> Engine request including streamed response reads (100-30000 ms).
ENGINE_REQUEST_TIMEOUT_MS=5000
ENGINE_ADDR=:8080
ORCHESTRATOR_BASE_URL=http://127.0.0.1:8090
ORCHESTRATOR_PORT=8090
# Required in production for Engine -> LangGraph service authentication.
ORCHESTRATOR_INTERNAL_TOKEN=
AUTH_DOMAIN=localhost:5173
AUTH_PURPOSE=login

# Server-only DeepSeek configuration for publisher task analysis. Never expose
# the API key through VITE_ or NEXT_PUBLIC_ variables.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000
# Base64-encoded 32-byte root key for local/dev envelope encryption. Generate
# and export it as documented in README; never commit a real value.
AGENT_CREDENTIAL_KEK_BASE64=
# Generate a distinct stable HMAC key so replay remains valid across KEK rotation.
AGENT_CREDENTIAL_IDEMPOTENCY_HMAC_BASE64=
AGENT_CREDENTIAL_KEY_REF=local-dev-agent-credentials-v1
# Keep false in production. Set true only when testing a private-network Agent.
AGENT_HEALTH_ALLOW_PRIVATE_NETWORKS=false

# Authoritative Engine module assembly and PostgreSQL Outbox worker. Keep this
# disabled until the HTTPS callback origin and process-secret credentials below
# are configured. Never commit real transport or callback credentials.
ENGINE_WORKER_ENABLED=false
ENGINE_WORKER_ID=
MATCHING_SHUFFLE_KEY_VERSION=matching-shuffle-v1
MATCHING_SHUFFLE_SECRET_BASE64=
EXECUTION_CALLBACK_BASE_URL=https://engine.example/v1/agent-callbacks
EXECUTION_INPUT_BASE_URL=https://engine.example
OVERVIEW_MAXIMUM_DURATION=15m
OVERVIEW_ALLOWED_TOOLS=read_task_input
EXECUTION_NONCE_KEY_VERSION=execution-nonce-v1
EXECUTION_NONCE_SECRET_BASE64=
# JSON object keyed by immutable Agent ID. Each callback key is distinct and
# base64-encodes at least 32 bytes.
ENGINE_AGENT_RUNTIME_CREDENTIALS_JSON={}
EXECUTION_CALLBACK_CLOCK_SKEW=5m
EXECUTION_CAPACITY_LEASE_TTL=10m
EXECUTION_AGENT_REQUEST_TIMEOUT=20s
ENGINE_OUTBOX_BATCH_SIZE=10
ENGINE_OUTBOX_LEASE=5m
ENGINE_OUTBOX_POLL_INTERVAL=1s
ENGINE_OUTBOX_BASE_BACKOFF=5s
ENGINE_OUTBOX_MAX_BACKOFF=15m
ENGINE_OUTBOX_MAX_ATTEMPTS=10

# Independent PostgreSQL Outbox -> AWS publisher. Run it as a separate process
# or ECS service with `/outbox-publisher`; production credentials come from its
# task role. `database` keeps formal execution on the embedded Engine worker.
# Switch to `sqs` only when an independent formal-execution SQS consumer is up.
ENGINE_FORMAL_EXECUTION_TRANSPORT=database
OUTBOX_PUBLISHER_ID=
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_PUBLISHER_BATCH_SIZE=10
OUTBOX_PUBLISHER_LEASE=2m
OUTBOX_PUBLISHER_POLL_INTERVAL=1s
OUTBOX_PUBLISHER_BASE_BACKOFF=5s
OUTBOX_PUBLISHER_MAX_BACKOFF=15m
OUTBOX_PUBLISHER_MAX_ATTEMPTS=10

# Independent formal-execution SQS consumer. The consumer name is a stable
# logical identity shared by all replicas; do not include a hostname or PID.
FORMAL_EXECUTION_CONSUMER_NAME=formal-execution-v1
SQS_CONSUMER_WAIT_TIME=20s
SQS_CONSUMER_VISIBILITY_TIMEOUT=2m
SQS_CONSUMER_HEARTBEAT_INTERVAL=30s
SQS_CONSUMER_API_TIMEOUT=25s
SQS_CONSUMER_BASE_BACKOFF=5s
SQS_CONSUMER_MAX_BACKOFF=5m

# Local infrastructure
DATABASE_URL=postgres://agent:agent@localhost:5432/agent_platform?sslmode=disable
REDIS_URL=redis://localhost:6379/0
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
TASK_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:agent-task-events
AGENT_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:agent-events
TASK_EXECUTION_QUEUE_URL=http://localhost:4566/000000000000/agent-formal-execution.fifo
ADMIN_OPERATION_QUEUE_URL=http://localhost:4566/000000000000/admin-operations.fifo

# Ethereum testnet configuration (decision pending)
# Local development chain only; configure an approved chain per environment.
EVM_CHAIN_ID=31337
EVM_RPC_URL=
EVM_RPC_ALLOW_PRIVATE_HTTP=false
ESCROW_CONTRACT_ADDRESS=
ESCROW_ASSET_ADDRESS=
# Server-side expected resolver address for canonical dispute-freeze reconciliation.
# It must match the resolver configured in TaskEscrow; it is never a signing key.
DISPUTE_RESOLVER_ADDRESS=
# JSON array for every retained old deployment, for example:
# [{"chainId":"84532","contractAddress":"0x...","assetKey":"evm:84532/native","disputeResolverAddress":"0x..."}]
ESCROW_LEGACY_DEPLOYMENTS_JSON=
# Separate server-only signing keys. Never expose or commit real values.
SELECTION_PROOF_SIGNING_KEY_HEX=
DELIVERY_PROOF_SIGNING_KEY_HEX=
ESCROW_DEPLOYMENT_BLOCK=0
EVM_CONFIRMATIONS=12
EVM_MAX_REORG_DEPTH=64
FUNDS_ASSET=
# Required only when resolving a change order as platform responsibility.
PLATFORM_INCIDENT_OWNER_ID=

# Mastra one-sentence image generation Agent (Zhipu GLM-Image)
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IMAGE_AGENT_PORT=8092
IMAGE_AGENT_DATA_DIR=.data/image-generator
IMAGE_AGENT_API_TOKEN=
IMAGE_AGENT_PUBLIC_BASE_URL=
IMAGE_AGENT_PLANNER_MODEL=glm-4.5-flash
IMAGE_AGENT_JOB_CONCURRENCY=1
IMAGE_AGENT_CALLBACK_KEY_BASE64=
IMAGE_AGENT_CALLBACK_KEY_VERSION=image-agent-callback-v1

# Qwen UI prototype Agent (Alibaba Cloud Model Studio)
QWEN_UI_DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com
QWEN_UI_AGENT_PORT=8095
QWEN_UI_AGENT_DATA_DIR=.data/qwen-ui-prototype
QWEN_UI_AGENT_API_TOKEN=
QWEN_UI_AGENT_PUBLIC_BASE_URL=
QWEN_UI_AGENT_MODEL=qwen-image-3.0-pro
QWEN_UI_AGENT_JOB_CONCURRENCY=1
QWEN_UI_AGENT_CALLBACK_KEY_BASE64=
QWEN_UI_AGENT_CALLBACK_KEY_VERSION=qwen-ui-prototype-callback-v1

# Seedream visual design Agent (Volcengine Ark)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_AGENT_PORT=8096
SEEDREAM_AGENT_DATA_DIR=.data/seedream-visual-design
SEEDREAM_AGENT_API_TOKEN=
SEEDREAM_AGENT_PUBLIC_BASE_URL=
SEEDREAM_AGENT_MODEL=doubao-seedream-5-0-lite-260128
SEEDREAM_AGENT_JOB_CONCURRENCY=1
SEEDREAM_AGENT_CALLBACK_KEY_BASE64=
SEEDREAM_AGENT_CALLBACK_KEY_VERSION=seedream-visual-design-callback-v1

# Platform protocol endpoints for the two image-to-code Agents
GLM_IMAGE_TO_CODE_AGENT_PORT=8093
GLM_IMAGE_TO_CODE_AGENT_DATA_DIR=.data/glm-image-to-code
GLM_IMAGE_TO_CODE_AGENT_API_TOKEN=
GLM_IMAGE_TO_CODE_AGENT_PUBLIC_BASE_URL=
GLM_IMAGE_TO_CODE_AGENT_CALLBACK_KEY_BASE64=
GLM_IMAGE_TO_CODE_AGENT_CALLBACK_KEY_VERSION=glm-image-to-code-callback-v1
QWEN_IMAGE_TO_CODE_AGENT_PORT=8094
QWEN_IMAGE_TO_CODE_AGENT_DATA_DIR=.data/qwen-image-to-code
QWEN_IMAGE_TO_CODE_AGENT_API_TOKEN=
QWEN_IMAGE_TO_CODE_AGENT_PUBLIC_BASE_URL=
QWEN_IMAGE_TO_CODE_AGENT_CALLBACK_KEY_BASE64=
QWEN_IMAGE_TO_CODE_AGENT_CALLBACK_KEY_VERSION=qwen-image-to-code-callback-v1
