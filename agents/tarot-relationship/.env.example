TAROT_AGENT_PORT=8091
TAROT_AGENT_DATA_DIR=.data/tarot-relationship
TAROT_AGENT_API_TOKEN=replace-with-a-long-random-token
TAROT_AGENT_PUBLIC_BASE_URL=https://tarot-agent.example
TAROT_AGENT_CALLBACK_KEY_BASE64=replace-with-32-byte-base64-key
TAROT_AGENT_CALLBACK_KEY_VERSION=tarot-callback-v1

# Optional OpenAI-compatible structured-output provider. When omitted, the
# Agent uses its deterministic local interpretation renderer.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
