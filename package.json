{
  "name": "agent-platform",
  "private": true,
  "workspaces": [
    "agents/*",
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx run-many -t build --parallel=1",
    "check-types": "nx run-many -t check-types",
    "test": "nx run-many -t test",
    "dev:web": "nx run web:dev",
    "dev:bff": "nx run @agent-platform/bff:dev",
    "dev:engine": "nx run @agent-platform/engine:dev",
    "dev:engine:secure": "sh ./scripts/start-local-engine-keychain.sh",
    "dev:orchestrator": "nx run @agent-platform/orchestrator:dev",
    "dev:publisher": "pnpm --filter @agent-platform/engine dev:publisher",
    "dev:consumer": "pnpm --filter @agent-platform/engine dev:consumer",
    "dev:chain": "anvil --silent --host 127.0.0.1 --port 8545 --chain-id 31337 --block-time 1",
    "chain:deploy": "sh ./scripts/deploy-local-escrow.sh",
    "chain:verify-nonce": "sh ./scripts/verify-work-nonce-anvil.sh",
    "abi:generate": "node ./scripts/generate-escrow-bindings.mjs",
    "abi:check": "node ./scripts/generate-escrow-bindings.mjs --check",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "acceptance:up": "sh ./scripts/local-acceptance.sh up",
    "acceptance:smoke": "sh ./scripts/local-acceptance.sh smoke",
    "acceptance:verify": "sh ./scripts/local-acceptance.sh verify",
    "acceptance:down": "sh ./scripts/local-acceptance.sh down"
  },
  "dependencies": {
    "@agent-platform/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agent-platform/config": "workspace:*",
    "@types/node": "catalog:",
    "nx": "^23.1.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.22.0"
}
